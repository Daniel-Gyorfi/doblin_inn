package view

templ ErrorInternalServer() {
	<div class="w-full h-full bg-gradient-to-t from-slate-100 to-slate-200 px-10 pb-3 pt-10 ">
		<style>
            body {
                --tw-bg-opacity: 1;
                background-color: rgb(241 245 249 / var(--tw-bg-opacity));
            }
        </style>
		<div class="bg-slate-300 p-3 border-r border-b border-slate-400 rounded w-[90%] sm:w-1/2 mx-auto mb-20 pb-10">
			<h1 class="flex justify-center text-lg">Error 50X</h1>
			<p class="">
				There has been an internal error in our servers. Thank you for your patience!
			</p>
		</div>
	</div>
	// div exists so that contents stack vertically but the whole thing will still get centered
}
