
package view

import "gitlab.com/DG_Blaster/doblin_inn/models"

templ Location_Index(loc models.Location) {
	<div class="w-full h-full bg-gradient-to-t from-slate-100 to-slate-200 px-10 pb-3 pt-10 ">
		<div
			class="bg-slate-300 p-3 border-r border-b border-slate-400 rounded w-[90%] mx-auto mb-auto flex flex-col"
		>
			<h1 class="mb-4 w-full flex font-semibold justify-center text-lg">{ loc.Name }</h1>
			<div class="w-full flex justify-center border-slate-700 border-x border-y">
				<img src={ "/assets/" + loc.Img } alt="location pic" width="800" height="800"/>
			</div>
		</div>
	</div>
}
