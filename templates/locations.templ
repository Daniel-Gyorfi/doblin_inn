package view

import "gitlab.com/DG_Blaster/doblin_inn/models"

templ Locate(locations []models.Location) {
	<div class="bg-gradient-to-t from-slate-100 to-slate-200 relative pt-10 px-2 gap-y-2 flex flex-col">
		for _, loc := range locations {
			<a
				href=""
				class="bg-slate-300 p-3 border-r border-b border-slate-400 rounded w-[90%] mx-auto mb-auto flex flex-col hover:border-red-400 hover:text-red-700 hover:border-l-4"
			>
				<div class="flex">
					<img src={ "assets/" + loc.Img } alt="location pic" width="100" height="100"/>
					<div class="font-bold">
						{ loc.Name }
					</div>
				</div>
				<div>
					{ loc.Descript }
				</div>
			</a>
		}
	</div>
}
